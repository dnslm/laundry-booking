# Скопируйте этот файл в backend/.env и подставьте свои значения.
# Настоящий .env в git не попадает.

PORT=3000

# SQLite: файл создастся сам. Для PostgreSQL: postgresql://user:password@localhost:5432/laundry
DATABASE_URL="file:./dev.db"

# Секрет для подписи токенов: длинная случайная строка, у каждого своя локально
JWT_SECRET=change-me-to-a-long-random-string
