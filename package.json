{
  "name": "laundry-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Система бронирования стиральных машин в общежитии",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "yarn workspaces foreach -A run typecheck",
    "tests": "yarn workspaces foreach -A run test",
    "build:all": "yarn workspaces foreach -A run build",
    "postinstall": "husky || true"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "typescript-eslint": "^8.72.2"
  }
}
